[Unit]
# Fifteen minutes is the most review work you can lose. Raising it costs nothing
# while idle — mw-commit-stories exits without committing when nothing changed,
# and skips entirely while a write is running.
Description=Commit story approvals every 15 minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=15min
# Catch up after a reboot or a stopped instance rather than waiting for the
# next interval.
Persistent=true

[Install]
WantedBy=timers.target
