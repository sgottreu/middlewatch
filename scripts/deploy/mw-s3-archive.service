[Unit]
# One backup sweep: every story's audio and images to S3, then the SFX cache.
# Driven by mw-s3-archive.timer; also safe to run by hand with
# `sudo systemctl start mw-s3-archive`.
#
# Install:  sudo install -m 644 scripts/deploy/mw-s3-archive.{service,timer} /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now mw-s3-archive.timer
#
# No credentials here. The instance has an IAM role, so the aws CLI picks up
# temporary credentials from the instance metadata service and there is nothing
# on disk to leak or rotate. See docs/story/aws.md.
Description=Back up story assets to S3
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/srv/middlewatch
ExecStart=/usr/local/bin/mw-s3-archive push-all

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
