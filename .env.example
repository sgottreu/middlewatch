# Text agents: ideator, writer, editor, designer's shot planning
ANTHROPIC_API_KEY=sk-ant-...

# Only needed when the key above is identity-linked (a personal or service
# account key) and can reach more than one workspace. Such a key must name the
# workspace on every request, or the API returns a 400. Find the id in the ID
# column of Settings -> Workspaces in the Claude Console.
#
# A key scoped to a single workspace carries the workspace with it and needs
# nothing here — that is the simpler fix if you are creating a key anyway.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Designer's image generation
GEMINI_API_KEY=...

# Actor
ELEVENLABS_API_KEY=...

# Actor, only if tts_provider is set to polly
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1
